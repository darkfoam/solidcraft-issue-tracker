# Path to the triage SQLite database. Defaults to ./data/triage.sqlite.
# The app and the Go ingester share this file. Writes are limited to the
# cluster/work tables; issue sync is handled by the triage binary.
TRIAGE_DB_PATH=./data/triage.sqlite

# Optional path to the triage binary. Defaults to ./triage/bin/triage.
TRIAGE_BIN=./triage/bin/triage

# How long the in-process graph remains cached before the database mtime is
# checked again. Defaults to 60000 milliseconds.
GRAPH_CACHE_TTL_MS=60000

# Optional: run the Go sync + retag on this interval. 0 disables scheduling.
# 3600000 = hourly. The first scheduled run is after the interval.
SYNC_INTERVAL_MS=0

# Optional: run one sync shortly after server startup when scheduling is on.
SYNC_ON_START=0

# Optional: require this bearer token for queue mutations and manual sync.
# Leave unset for a local-only instance. Never commit a real token.
AGENT_TOKEN=

# adapter-node port. Defaults to 3000 when unset.
PORT=3000
