# Path to the read-only triage SQLite database.
# Defaults to ~/solidcraft-triage/analysis/triage.sqlite when unset.
TRIAGE_DB_PATH=/absolute/path/to/solidcraft-triage/analysis/triage.sqlite

# How long the in-process graph remains cached before the database mtime is
# checked again. Defaults to 60000 milliseconds.
GRAPH_CACHE_TTL_MS=60000

# adapter-node port. Defaults to 3000 when unset.
PORT=3000
