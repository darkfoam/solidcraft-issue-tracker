{
	"name": "solidcraft-issues",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"verify": "npm run check && npm run lint && npm run triage:test && npm run build",
		"triage:build": "cd triage && go build -o bin/triage ./cmd/triage",
		"sync": "node scripts/sync.mjs",
		"sync:full": "node scripts/sync.mjs --full",
		"mcp:issues": "node mcp/server.mjs",
		"triage:test": "cd triage && go test ./...",
		"mcp:http": "node mcp/http.mjs"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"d3-force": "^3.0.1",
		"graphology": "^0.26.0",
		"sigma": "^4.0.6",
		"zod": "^4.6.7"
	}
}
