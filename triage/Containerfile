FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/triage ./cmd/triage

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/triage /usr/local/bin/triage
ENV TRIAGE_DB=/data/triage.sqlite
ENTRYPOINT ["/usr/local/bin/triage"]
